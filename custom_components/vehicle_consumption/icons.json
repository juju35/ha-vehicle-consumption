      "fuel_consumption_month": { "default": "mdi:gas-station-outline" },
      "fuel_consumption_average": { "default": "mdi:gas-station" },
      "energy_consumption_trip": { "default": "mdi:lightning-bolt-outline" },
      "energy_consumption_month": { "default": "mdi:lightning-bolt-outline" },
      "energy_consumption_average": { "default": "mdi:lightning-bolt" },
      "distance_trip": { "default": "mdi:map-marker-distance" },
      "distance_month": { "default": "mdi:map-marker-path" },
      "fuel_used_month": { "default": "mdi:fuel" },
      "energy_used_month": { "default": "mdi:battery-charging-medium" },
      "cost_month": { "default": "mdi:cash" },
